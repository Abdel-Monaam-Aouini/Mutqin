root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

[Makefile]
indent_style = tab

[data/quran/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
